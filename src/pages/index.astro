---
import Layout from "@layouts/Layout.astro";
import Hardhat from "@lib/svg/hardhat.svg";
import TitleLine from "@components/TitleLine.svelte";
import SurveyPhases from "@components/SurveyPhases.svelte";
import { getCollection } from "astro:content";
import toc from "@lib/toc.json";

const allPages = await getCollection("pages");
const pageMap = Object.fromEntries(allPages.map((page) => [page.id, page]));

type TocSection = {
	label: string;
	children: string[];
	excludeFromGraphic?: string[];
	showInGraphic?: boolean;
};

// Build phases from toc sections (exclude sections with showInGraphic: false)
const graphicSections = (toc.sections as any[]).filter(
	(s): s is TocSection => typeof s === "object" && s.showInGraphic !== false,
);

const phases = graphicSections.map((section: TocSection) => ({
	id: section.children[0].replace(/-einleitung$/, ""),
	label: section.label,
	href: "/" + section.children[0],
}));

// Build knowledge markers from toc sections (skip intro pages + excluded slugs + non-graphic sections)
const knowledgeMarkers = graphicSections.flatMap(
	(section: TocSection, phaseIndex: number) => {
		const exclude = section.excludeFromGraphic || [];
		return section.children
			.slice(1) // skip intro page
			.filter((slug: string) => !exclude.includes(slug))
			.map((slug: string) => ({
				label: pageMap[slug]?.data.tocTitle || slug,
				type: "knowledge" as const,
				href: "/" + slug,
				phase: phaseIndex,
			}));
	},
);

// Spanning markers (compute grid rows from phase indices)
const spanningMarkers = toc.spanning.map((s) => ({
	label: s.label,
	type: "knowledge" as const,
	href: s.href,
	startRow: s.startPhase * 2 + 1,
	endRow: s.endPhase * 2 + 2,
	column: s.column,
}));

// Tool markers always link to anchor on the tools page
// Flatten tools with multiple phases into individual markers for the graphic
const toolMarkers = (toc.tools as any[]).flatMap((t) =>
	t.phases.map((p: number) => ({ ...t, phase: p, href: `/tools#${t.id}` })),
);

const markers = [...spanningMarkers, ...knowledgeMarkers, ...toolMarkers];
---

<Layout line="false">
	<body>
		<div class="logo-container">
			<Hardhat />
		</div>
		<section>
			<p>
				<h1>Civic Data Lab Umfragenwerkstatt</h1>
				<h2>Unterstützungsangebote für die Umsetzung Eurer Online-Umfrage</h2>

				<div class="intro">
					<p>
						Ihr seid Euch unsicher, wie Ihr die Fragen für Eure
						bevorstehende Online-Umfrage gut ausformulieren sollt? Habt
						bereits Daten erhoben, aber bei der Auswertung der
						Ergebnisse stockt es? Oder seid einfach nur auf der
						Suche nach einer guten Vorlage für die
						Datenschutzinformationen? – Dann seid Ihr hier genau
						richtig!
					</p>
					<p>
						<strong
							>In unserer Ressourcensammlung bieten wir
							Unterstützung für die einzelnen Phasen von Online-Umfragen:
							Empfehlungen, Wissen und Anleitungen, sowie
							Open-Source-Tools für die praktische Umsetzung.</strong
						>
					</p>
				</div>

				<h2>Wieso ist das relevant?</h2>
				<p>
					Für viele zivilgesellschaftliche Organisationen sind
					Umfragen eine wichtige Datenquelle: um mehr über die <a
						href="https://civic-data.de/machen/ki_im_ehrenamt_auswertung_einer_umfrage/"
						>konkreten Bedarfe der Zielgruppe</a
					> oder des <a
						href="https://civic-data.de/machen/jaehrliche-erhebung-tensing/"
						>eigenen Netzwerks</a
					> zu erfahren, oder um die Wirkung der eigenen Arbeit zu erfassen.
				</p>
				<p>
					Dabei beobachten wir typische Fehler: Umfragen werden nicht
					in all ihren Phasen gedacht, Erkenntnisse aus der
					Umfrageforschung bleiben ungenutzt, und nach der Erhebung
					ist unklar, welche Handlungen folgen sollen. Im
					ungünstigsten Fall werden die Daten dadurch unbrauchbar oder
					die Auswertung erheblich erschwert. Unser
					Unterstützungsangebot setzt hier an.
				</p>
			</p>

			<h2>Unser Ansatz</h2>
			<p>
				Die Umfragenwerkstatt verbindet zwei Bausteine: eine <strong
					>Wissenssammlung</strong
				> und einen abgestimmten <strong
					>Stack aus empfohlenen und selbst entwickelten Tools</strong
				>. Gemeinsam sollen sie die Arbeit mit Online-Umfragen in der
				Zivilgesellschaft erleichtern und stärker standardisieren.
			</p>
			<p>
				Im Zentrum stehen <strong>offene Formate</strong> wie <a
					href="/xlsform-standard">XLSForm</a
				> und <a href="/methodik-veroeffentlichen">DDI-Codebook</a>: Sie
				sind werkzeugübergreifend nutzbar, erleichtern Archivierung und
				Nachnutzung von Daten und vermeiden Abhängigkeiten von einzelnen
				Anbietern. Damit diese Formate in der Praxis gut funktionieren,
				empfehlen wir einen aufeinander abgestimmten Stack bewährter
				Tools – und schließen dort, wo das offene Ökosystem Lücken
				lässt, mit eigenen Open-Source-Entwicklungen an. Wie Formate und
				Tools in einem empfohlenen Workflow zusammenspielen, zeigt die <a
					href="/workflow">Workflow-Seite</a
				>.
			</p>
			<p>
				Die Wissenssammlung bildet das inhaltliche Fundament: Sie
				bündelt Methoden, Erfahrungen und Beispiele aus der Praxis
				zivilgesellschaftlicher Organisationen und ist direkt auf die
				empfohlenen Formate und Tools abgestimmt. So entsteht eine
				gemeinsame Grundlage, die gute Praktiken breiter zugänglich
				macht und Umfragearbeit über einzelne Projekte hinweg
				vergleichbarer und nachnutzbarer macht.
			</p>
			<section>
				<h3 id="phasenmodel">Überblick: Ressourcen nach Phase</h3>
				<p>
					Eine Umfrage durchläuft typischerweise mehrere Phasen – von
					der ersten Konzeption über die Erhebung bis hin zur
					Auswertung und Veröffentlichung. Die folgende Übersicht
					ordnet unsere Ressourcen, Formate und Tools diesen Phasen
					zu, sodass Ihr direkt findet, was für Euren aktuellen
					Schritt relevant ist.
				</p>
				<SurveyPhases phases={phases} markers={markers} client:load />
			</section>
			<section class="ecosystem-section"></section>
			<h2>Nun kann es losgehen!</h2>
			<section>
				<p>
					Mit dieser Sammlung schließen wir Lücken im Angebot von
					Hilfsmitteln zur Umsetzung von Umfragen. Denn natürlich gibt
					es bereits viele gute Angebote an Lern- und
					Unterstützungsmaterialien. Eine umfassende Sammlung findet
					Ihr u.a. auch in unserer <a
						href="https://civic-data.de/lernen/">CDL Academy</a
					>.
				</p>
				<p>
					Ihr wollt mit Eurer Umfrage loslegen, aber wisst doch noch
					nicht so richtig wie? Dann schaut vorbei in unserer
					Datensprechstunde. <a
						href="https://zeeg.me/correlaid/dss-cdl"
						>Hier geht’s zur Terminbuchung</a
					>.
				</p>
			</section>
		</section>

		<style>
			section {
				margin-top: 2.5rem;
			}
			.transformations-table {
				width: 100%;
				border-collapse: collapse;
				margin: 1rem 0;
				font-size: 0.9rem;
			}

			.transformations-table th,
			.transformations-table td {
				border: 1px solid var(--color-text-primary);
				padding: 0.5rem 0.75rem;
				text-align: left;
			}

			.transformations-table thead {
				background-color: var(--color-tertiary);
				font-family: var(--font-family-mono);
				font-weight: var(--font-weight-bold);
			}

			.logo-container {
				margin-top: 1rem;
				padding-top: 1rem;
				margin-bottom: 2.5rem;
				background-color: var(--color-tertiary);
				border-radius: 2rem;
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: center;
			}

			.logo-container :global(svg) {
				padding-bottom: 3.5rem;
				padding-top: 3.5rem;
				width: 100%;
				max-width: 600px;
				height: auto;
			}

			@media (max-width: 768px) {
				.logo-container :global(svg) {
					max-width: 100%;
					padding: 1rem;
					padding-bottom: 0.5rem;
				}

				.logo-container {
					margin-top: 3rem;
					margin-bottom: 1rem;
					margin-left: 1rem;
					margin-right: 1rem;
				}
			}
		</style>
	</body>
</Layout>
