---
import Layout from "@layouts/Layout.astro";
import QuellenList from "@components/Literature.svelte";
import { getLiveCollection, getCollection } from "astro:content";
import { usedCitations, isCited } from "@lib/utils/citations";

// Get all pages to find used citations
const allPages = await getCollection("pages");
const used = usedCitations(allPages.map(page => page.body || ""));

// Get quellen from live collection
const { entries: quellen, error } = await getLiveCollection("quellen");

// Filter quellen to only include used items
const usedQuellen = quellen ? quellen.filter(item => isCited(item, used)) : [];

// Prepare error message for display
const errorMessage = error ? (error.message || 'Unknown error loading quellen') : null;

if (error) {
  console.error("Error loading quellen collection:", error);
}

// Sort quellen alphabetically by first author's last name
const sortedQuellen = usedQuellen.sort((a, b) => {
  const getSortName = (item: any) => {
    const firstCreator = item.data.creators?.[0];
    if (!firstCreator) return item.data.title || '';
    return firstCreator.lastName || firstCreator.name || '';
  };

  const nameA = getSortName(a).toLowerCase();
  const nameB = getSortName(b).toLowerCase();
  
  if (nameA < nameB) return -1;
  if (nameA > nameB) return 1;
  return 0;
});
---

<Layout title="Quellen" teaser="Verzeichnis der in der Wissensammlung verwendeten Quellen.">
    <QuellenList client:load items={sortedQuellen} error={errorMessage} />
</Layout>
